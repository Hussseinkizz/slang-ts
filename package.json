{
  "name": "slang-ts",
  "version": "0.2.2",
  "description": "Functional programming utilities for TypeScript: Option, Result, SafeTry, pattern matching, async control, and data helpers",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "skill",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "typecheck": "tsc --noEmit",
    "build": "tsdown",
    "export": "bun run test && bun run typecheck && bun run build",
    "prepublishOnly": "bun run export"
  },
  "homepage": "https://github.com/Hussseinkizz/slang#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hussseinkizz/slang.git"
  },
  "bugs": {
    "url": "https://github.com/Hussseinkizz/slang/issues"
  },
  "keywords": [
    "functional",
    "typescript",
    "option",
    "maybe",
    "result",
    "safe-try",
    "pattern-matching",
    "match",
    "monad",
    "pipe",
    "zip",
    "async",
    "promise",
    "superpromise",
    "superrunner",
    "cancellation",
    "abort",
    "signal",
    "channel",
    "event-bus",
    "defensive programming",
    "fp-ts",
    "ramda",
    "neverthrow",
    "lodash"
  ],
  "author": "Hussein Kizz",
  "license": "MIT",
  "sideEffects": [
    "./dist/index.js"
  ],
  "devDependencies": {
    "@types/bun": "latest",
    "@vitest/ui": "^4.1.10",
    "vitest": "^4.1.10",
    "tsdown": "0.23.1",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "typescript": "^5.9.3 || ^7.0.2"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  }
}
